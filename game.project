[project]
title = Uncharted Waters 2
version = 0.1.0
custom_resources = /assets/data

[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 1640
height = 800
high_dpi = 0
vsync = 1

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

[script]
shared_state = 1

[sprite]
max_count = 256

[tilemap]
max_count = 4
max_tile_count = 4096

[gui]
max_count = 4096
max_particlefx_count = 0

[sound]
max_sound_instances = 32

[html5]
scale_mode = fit
